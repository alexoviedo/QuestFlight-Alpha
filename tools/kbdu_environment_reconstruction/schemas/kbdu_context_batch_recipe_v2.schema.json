{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "building_batches": {
      "type": "array"
    },
    "parked_aircraft_batches": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "placements": {
            "items": {
              "properties": {
                "base_y_meters": {
                  "type": "number"
                },
                "color_rgba": {
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                },
                "placement_v2": {
                  "type": "object",
                  "properties": {
                    "stable_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "stand_group": {
                      "type": "string"
                    },
                    "terrain_height_meters": {
                      "type": "number"
                    },
                    "ground_clearance_meters": {
                      "const": 0.025
                    },
                    "orthophoto_alignment": {
                      "const": "active_2020_city_aircraft_silhouette"
                    },
                    "orthophoto_path": {
                      "type": "string"
                    },
                    "orthophoto_guid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{32}$"
                    },
                    "orthophoto_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "orthophoto_source_pixel": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "integer"
                      }
                    },
                    "orthophoto_source_axis_pixels": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "integer"
                      }
                    }
                  },
                  "required": [
                    "stable_id",
                    "stand_group",
                    "terrain_height_meters",
                    "ground_clearance_meters",
                    "orthophoto_alignment",
                    "orthophoto_path",
                    "orthophoto_guid",
                    "orthophoto_sha256",
                    "orthophoto_source_pixel",
                    "orthophoto_source_axis_pixels"
                  ]
                },
                "x_meters": {
                  "type": "number"
                },
                "yaw_degrees": {
                  "type": "number"
                },
                "z_meters": {
                  "type": "number"
                },
                "model_family": {
                  "enum": [
                    "powered_c172",
                    "sailplane"
                  ]
                },
                "pitch_degrees": {
                  "const": 0.0
                },
                "roll_degrees": {
                  "type": "number"
                },
                "wing_down_side": {
                  "enum": [
                    "none",
                    "left",
                    "right"
                  ]
                }
              },
              "required": [
                "x_meters",
                "base_y_meters",
                "z_meters",
                "yaw_degrees",
                "color_rgba",
                "placement_v2",
                "model_family",
                "pitch_degrees",
                "roll_degrees",
                "wing_down_side"
              ],
              "type": "object"
            },
            "maxItems": 35,
            "minItems": 35,
            "type": "array"
          }
        },
        "required": [
          "id",
          "placements"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "vegetation_batches": {
      "type": "array"
    }
  },
  "required": [
    "building_batches",
    "vegetation_batches",
    "parked_aircraft_batches"
  ],
  "title": "KBDU Unity-compatible context batch recipe V2",
  "type": "object"
}
