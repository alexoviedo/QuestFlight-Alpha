* text=auto

# Stable text serialization and scripts
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.ps1 text eol=lf

# Preserve checksum-pinned authoring inputs byte-for-byte, including their
# generated trailing blank line.
tools/scenery/conda-lock-win-64.txt whitespace=-blank-at-eof
tools/scenery/lidar/ept_snapshot.py whitespace=-blank-at-eof
# Unity's serializer emits blank scalar values with a trailing space. Preserve
# stable LF serialization while excluding that generated convention from
# whitespace-error checks.
*.unity text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof
*.prefab text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof
*.asset text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof
*.mat text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof
*.mixer text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof
*.controller text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof
*.meta text eol=lf merge=unityyamlmerge whitespace=-blank-at-eol,-blank-at-eof

# Frozen JSBSim runtime payload hashes cover the exact promoted package bytes.
# Preserve those bounded data files byte-for-byte instead of normalizing CRLF.
QuestFlight/Packages/com.alexoviedo.questflight.jsbsim/RuntimeData/** -text -eol whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Binary product assets must enter through Git LFS after rights review.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.bytes filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text

# Redistributable interface font sources (license recorded alongside assets).
*.ttf filter=lfs diff=lfs merge=lfs -text
