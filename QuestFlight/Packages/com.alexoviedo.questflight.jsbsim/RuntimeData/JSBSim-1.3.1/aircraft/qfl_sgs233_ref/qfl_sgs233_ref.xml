  <aerodynamics>
    <axis name="DRAG">
      <function name="aero/coefficient/CD0">
        <description>Drag_at_zero_lift</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <sum>
            <value>0.041744874521968664</value>
            <product>
              <property>aero/cl-squared</property>
              <value>0.04907018591220798</value>
            </product>
            <product>
              <value>-0.0745262303838689</value>
              <sqrt>
                <property>aero/cl-squared</property>
              </sqrt>
            </product>
            <table>
              <independentVar>aero/alpha-rad</independentVar>
              <tableData>-1.5708 1.5
-.35 .05
-.30 0
.30 0
.35 .05
1.5708 1.5</tableData>
