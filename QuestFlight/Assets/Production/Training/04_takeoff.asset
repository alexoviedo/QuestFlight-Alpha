%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 04_takeoff
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 04_takeoff
  displayName: Takeoff and departure
  briefing: Start stopped on runway zero eight. Check the aircraft, take off and
    climb straight ahead. Review the references before starting; instructions become
    brief during the roll.
  briefingNarration: {fileID: 8300000, guid: b353f4945bd486049bdac8e21410ff24, type: 3}
  start:
    latitudeDegrees: 40.03909497191087
    longitudeDegrees: -105.23259094603033
    altitudeMslMeters: 1612.8124000011921
    terrainElevationMslMeters: 1611.5624000011921
    calibratedAirspeedKnots: 0
    headingDegrees: 89.97200012207031
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: 0
    engineRunning: 1
  initialThrottle: 0.1
  initialTrim: 0
  initialFlaps: 0
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: -1
  stages:
  - title: Takeoff configuration
    instruction: While stopped, check runway alignment and the flap indication. This
      checkpoint has mixture and carb heat preset.
    narration: {fileID: 8300000, guid: 9f257ed6b219f66498d2ba4c379a489e, type: 3}
    task: 11
    reference: 9
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Takeoff roll
    instruction: Release brakes and smoothly apply full power. Keep the centerline
      with rudder.
    narration: {fileID: 8300000, guid: adb0aea07660e384f84fd88206a1a662, type: 3}
    task: 12
    reference: 7
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 0.15
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Rotate
    instruction: At about fifty-five knots, gently raise the nose. Establish the
      climb as the aircraft lifts off.
    narration: {fileID: 8300000, guid: f3ce43a3a5d3f004d9e92dbba71602b7, type: 3}
    task: 13
    reference: 1
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Departure climb
    instruction: Climb straight ahead through six thousand feet. Hold seventy to
      eighty knots.
    narration: {fileID: 8300000, guid: 5be478bec96d4a744853721d4db46a5f, type: 3}
    task: 14
    reference: 1
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 6000
    speedKnots: 75
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 000000000200000004000000030000000100000007000000060000000a00000009000000
