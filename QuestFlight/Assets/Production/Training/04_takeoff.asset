%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 04_takeoff
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 04_takeoff
  displayName: Takeoff and departure
  briefing: Start lined up and stopped on runway 08. Check the available controls,
    apply power, rotate near 55 knots and climb at 70 to 80 knots. Maintain the runway
    direction. This exercise uses the existing traffic protection; it does not simulate
    radio clearance or a complete preflight checklist.
  briefingNarration: {fileID: 8300000, guid: b353f4945bd486049bdac8e21410ff24, type: 3}
  start:
    latitudeDegrees: 40.03909497191087
    longitudeDegrees: -105.23259094603033
    altitudeMslMeters: 1612.8124000011921
    terrainElevationMslMeters: 1611.5624000011921
    calibratedAirspeedKnots: 0
    headingDegrees: 89.97200012207031
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: 0
    engineRunning: 1
  initialThrottle: 0.1
  initialTrim: 0
  initialFlaps: 0
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: -1
  stages:
  - title: Takeoff configuration
    instruction: Check alignment with runway 08, flaps zero to ten degrees, carb
      heat cold, and mixture set for this exercise. Hold stopped while checking.
    narration: {fileID: 8300000, guid: 9f257ed6b219f66498d2ba4c379a489e, type: 3}
    task: 11
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Takeoff roll
    instruction: Release brakes, apply full power smoothly, and keep the runway centerline
      with rudder. At about 55 knots, prepare to raise the nose.
    narration: {fileID: 8300000, guid: adb0aea07660e384f84fd88206a1a662, type: 3}
    task: 12
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 0.15
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Rotate
    instruction: Gently raise the nose near 55 knots. Let the airplane lift off,
      then adjust pitch toward a 70 to 80 knot climb.
    narration: {fileID: 8300000, guid: f3ce43a3a5d3f004d9e92dbba71602b7, type: 3}
    task: 13
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Departure climb
    instruction: Continue straight ahead at 70 to 80 knots. Climb through 6000 feet;
      do not turn early over the airport.
    narration: {fileID: 8300000, guid: 5be478bec96d4a744853721d4db46a5f, type: 3}
    task: 14
    heading: 90
    altitudeFeet: 6000
    speedKnots: 75
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
