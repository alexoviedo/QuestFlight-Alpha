%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 04_takeoff
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 04_takeoff
  displayName: Takeoff and departure
  briefing: Begin stopped and aligned on runway zero eight. This prepared checkpoint
    supplies the engine setup; it is not a full run-up or takeoff checklist. Review
    the highlighted controls before practice. During the roll, steer with the right
    thumbstick and watch the airspeed needle.
  briefingNarration: {fileID: 8300000, guid: b353f4945bd486049bdac8e21410ff24, type: 3}
  learningGoal: Stay on the runway, lift off near fifty-five knots and climb straight
    ahead at seventy to eighty knots. Real high-altitude takeoff preparation requires
    the aircraft checklist and performance planning.
  reflection: Were you looking along the centerline, with only brief airspeed checks?
  start:
    latitudeDegrees: 40.03909497191087
    longitudeDegrees: -105.23259094603033
    altitudeMslMeters: 1612.8124000011921
    terrainElevationMslMeters: 1611.5624000011921
    calibratedAirspeedKnots: 0
    headingDegrees: 89.97200012207031
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: 0
    engineRunning: 1
  initialThrottle: 0.1
  initialTrim: 0
  initialFlaps: 0
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: -1
  stages:
  - title: Confirm takeoff setup
    instruction: 'Keep stopped on the runway centerline. Check the flap selector
      and indication: zero to ten degrees for this exercise. The checkpoint has mixture
      and carb heat set. Identify the throttle and airspeed dial before rolling.'
    narration: {fileID: 8300000, guid: 9f257ed6b219f66498d2ba4c379a489e, type: 3}
    successFeedback: You began stopped, aligned and configured for this checkpoint.
    retryAdvice: Stay stopped and align with the runway. Check the flap indication
      before adding power.
    task: 11
    reference: 9
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Accelerate on centerline
    instruction: Release both brakes and smoothly move the throttle fully forward.
      Look along the centerline; steer with the steering thumbstick. Briefly check the
      airspeed needle. Prepare to lift the nose near fifty-five knots.
    narration: {fileID: 8300000, guid: adb0aea07660e384f84fd88206a1a662, type: 3}
    successFeedback: You accelerated on the runway with takeoff power and directional
      control.
    retryAdvice: Use full power smoothly and small rudder corrections. Prepare the
      rotation before speed runs away.
    task: 12
    reference: 7
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 0.15
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Lift off
    instruction: Near fifty-five knots, pull the yoke back gently to raise the nose.
      Let the airplane fly off, then adjust pitch toward seventy to eighty knots.
      Avoid a sudden pull.
    narration: {fileID: 8300000, guid: f3ce43a3a5d3f004d9e92dbba71602b7, type: 3}
    successFeedback: You lifted off in a controlled nose-up attitude.
    retryAdvice: Raise the nose gradually. If airspeed falls, ease the nose down
      rather than pulling harder.
    task: 13
    reference: 1
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Climb straight ahead
    instruction: Climb straight ahead at seventy to eighty knots. Keep the wings
      nearly level and pass six thousand feet on the altimeter. Continue scanning
      outside.
    narration: {fileID: 8300000, guid: 5be478bec96d4a744853721d4db46a5f, type: 3}
    successFeedback: You established the straight-ahead departure climb.
    retryAdvice: Use a steady climb attitude, adequate power and small rudder corrections.
      Monitor the airspeed needle.
    task: 14
    reference: 1
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 6000
    speedKnots: 75
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 000000000200000004000000030000000100000007000000060000000a00000009000000
