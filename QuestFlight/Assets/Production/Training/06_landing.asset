%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 06_landing
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 06_landing
  displayName: Landing and go-around
  briefing: 'Start on final for runway 08 at about 65 knots with twenty degrees of
    flaps. Stabilize the approach, flare, touch down and slow to taxi speed. You
    can instead choose a go-around: power, climb, and retract flaps in stages. A
    sensible go-around is a successful outcome. Do not force a poor approach onto
    the runway.'
  briefingNarration: {fileID: 8300000, guid: 07f6c7fc0ebe70349812143b06228153, type: 3}
  start:
    latitudeDegrees: 40.0390917437007
    longitudeDegrees: -105.25420359313061
    altitudeMslMeters: 1731.2640000000001
    terrainElevationMslMeters: 1624.9823950408936
    calibratedAirspeedKnots: 57.79188919067383
    headingDegrees: 89.97200012207031
    pitchDegrees: -3
    bankDegrees: 0
    flightPathAngleDegrees: -3
    engineRunning: 1
  initialThrottle: 0.16107373
  initialTrim: -0.08178711
  initialFlaps: 0.6666667
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: 3
  stages:
  - title: Stabilize final
    instruction: You have control. Keep the runway centered and hold 60 to 70 knots
      with a steady descent. Check alignment and configuration. If unstable, go around.
    narration: {fileID: 8300000, guid: 13a73e5eee886734aa949e43f8c9d636, type: 3}
    task: 18
    heading: 90
    altitudeFeet: 5680
    speedKnots: 65
    dwellSeconds: 4
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Flare and touchdown
    instruction: As the runway rises in your view, look farther down it. Reduce power
      and ease the nose up to arrest the descent. Keep the wings level and aligned.
      Go around if the landing will not be safe.
    narration: {fileID: 8300000, guid: bad7764e7886aee4aa30219e083104ec, type: 3}
    task: 19
    heading: 90
    altitudeFeet: 5300
    speedKnots: 65
    dwellSeconds: 0.3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Rollout
    instruction: Maintain the centerline, lower the nose gently and brake smoothly.
      Slow below eight knots while remaining on the paved runway.
    narration: {fileID: 8300000, guid: 4fdf8d4cae59e344c8655f5c698b0345, type: 3}
    task: 20
    heading: 90
    altitudeFeet: 5300
    speedKnots: 30
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Go-around power
    instruction: Go around. Full power, carb heat cold, and pitch for climb. Reduce
      full flaps to twenty degrees if necessary.
    narration: {fileID: 8300000, guid: ad23c551d8bfee7498e956003d56d521, type: 3}
    task: 21
    heading: 90
    altitudeFeet: 7000
    speedKnots: 65
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Positive climb
    instruction: Confirm positive climb, maintain safe airspeed and retract flaps
      to ten degrees. Keep the runway direction.
    narration: {fileID: 8300000, guid: 5811ab98becfa7a43822bd92c0c990af, type: 3}
    task: 22
    heading: 90
    altitudeFeet: 7000
    speedKnots: 65
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Clean climb
    instruction: Once clear of obstacles, retract the remaining flaps and continue
      a 70 to 80 knot climb straight ahead.
    narration: {fileID: 8300000, guid: 9d3decbd138e3c542aff6b135185e846, type: 3}
    task: 23
    heading: 90
    altitudeFeet: 7000
    speedKnots: 75
    dwellSeconds: 5
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
