  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 06_landing
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 06_landing
  displayName: Landing and go-around
  briefing: Start at a final-approach checkpoint. Practice a stable approach and
    landing, or choose a go-around. Review the controls first; do not force an unstable
    landing.
  briefingNarration: {fileID: 8300000, guid: 07f6c7fc0ebe70349812143b06228153, type: 3}
  start:
    latitudeDegrees: 40.0390917437007
    longitudeDegrees: -105.25420359313061
    altitudeMslMeters: 1731.2640000000001
    terrainElevationMslMeters: 1624.9823950408936
    calibratedAirspeedKnots: 57.79188919067383
    headingDegrees: 89.97200012207031
    pitchDegrees: -3
    bankDegrees: 0
    flightPathAngleDegrees: -3
    engineRunning: 1
  initialThrottle: 0.16107373
  initialTrim: -0.08178711
  initialFlaps: 0.6666667
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: 3
  stages:
  - title: Stabilize final
    instruction: Keep the runway centered. Hold sixty to seventy knots with a steady
      descent.
    narration: {fileID: 8300000, guid: 13a73e5eee886734aa949e43f8c9d636, type: 3}
    task: 18
    reference: 11
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 5680
    speedKnots: 65
    dwellSeconds: 4
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Flare and touchdown
    instruction: Look farther along the runway. Reduce power and gently arrest the
      descent for touchdown.
    narration: {fileID: 8300000, guid: bad7764e7886aee4aa30219e083104ec, type: 3}
    task: 19
    reference: 11
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 5300
    speedKnots: 65
    dwellSeconds: 0.3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Rollout
    instruction: Keep directional control and brake smoothly to taxi speed.
    narration: {fileID: 8300000, guid: 4fdf8d4cae59e344c8655f5c698b0345, type: 3}
    task: 20
    reference: 11
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 5300
    speedKnots: 30
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Go-around power
    instruction: Go around. Full power, pitch for climb. Reduce full flaps to twenty
      degrees.
    narration: {fileID: 8300000, guid: ad23c551d8bfee7498e956003d56d521, type: 3}
    task: 21
    reference: 7
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 65
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Positive climb
    instruction: With positive climb and safe speed, reduce flaps to ten degrees.
    narration: {fileID: 8300000, guid: 5811ab98becfa7a43822bd92c0c990af, type: 3}
    task: 22
    reference: 9
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 65
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Clean climb
    instruction: Clear of obstacles, retract remaining flaps and climb straight ahead.
    narration: {fileID: 8300000, guid: 9d3decbd138e3c542aff6b135185e846, type: 3}
    task: 23
    reference: 9
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 75
    dwellSeconds: 5
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 000000000200000004000000030000000100000007000000060000000a00000009000000
