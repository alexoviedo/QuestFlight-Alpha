%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 05_pattern
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 05_pattern
  displayName: Pattern and approach decisions
  briefing: Practice the north-side pattern for runway zero eight. Learn the runway
    references before starting. A safe go-around is a successful outcome.
  briefingNarration: {fileID: 8300000, guid: c720d84397695144a82e70730dce7efd, type: 3}
  start:
    latitudeDegrees: 40.04701844816733
    longitudeDegrees: -105.22140336838336
    altitudeMslMeters: 1920.24
    terrainElevationMslMeters: 1589.6624010681153
    calibratedAirspeedKnots: 95.09220123291016
    headingDegrees: 270
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: 0
    engineRunning: 1
  initialThrottle: 0.6279252
  initialTrim: -0.19077148
  initialFlaps: 0
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: 4
  stages:
  - title: Downwind
    instruction: Keep the runway on your left. Hold sixty-three hundred feet on the
      north-side downwind.
    narration: {fileID: 8300000, guid: 2815fedfe1d6d85458ec16d94bf78ad7, type: 3}
    task: 15
    reference: 11
    attitudeOnly: 0
    heading: 270
    altitudeFeet: 6300
    speedKnots: 85
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: -500, y: 850}
    captureMeters: 200
  - title: Abeam landing end
    instruction: Abeam the landing end, reduce power. Below flap speed, select ten
      degrees and begin descending.
    narration: {fileID: 8300000, guid: 5743734ddfd12344d9dbcc2966bb9134, type: 3}
    task: 16
    reference: 11
    attitudeOnly: 0
    heading: 270
    altitudeFeet: 6100
    speedKnots: 75
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: -1200, y: 850}
    captureMeters: 230
  - title: Left base
    instruction: Turn gently left onto base. Keep a shallow bank and a comfortable
      descent.
    narration: {fileID: 8300000, guid: e5006f6077eb9ce4fbde07bcac1b085f, type: 3}
    task: 17
    reference: 11
    attitudeOnly: 0
    heading: 180
    altitudeFeet: 5800
    speedKnots: 70
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: -1750, y: 350}
    captureMeters: 260
  - title: Stable final
    instruction: Align with the runway. Hold sixty to seventy knots on a steady final
      approach.
    narration: {fileID: 8300000, guid: 4b4adac9072ed1648b5e419acc528afd, type: 3}
    task: 18
    reference: 11
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 5500
    speedKnots: 65
    dwellSeconds: 6
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Go-around power
    instruction: Go around. Full power, pitch for climb. Reduce full flaps to twenty
      degrees.
    narration: {fileID: 8300000, guid: 81ea162c8d11ecd4ea6a813529f9456e, type: 3}
    task: 21
    reference: 7
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 65
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Positive climb
    instruction: With positive climb and safe speed, reduce flaps to ten degrees.
    narration: {fileID: 8300000, guid: 3f118453ee031714eb1c6995be4462e7, type: 3}
    task: 22
    reference: 9
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 65
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Clean climb
    instruction: Clear of obstacles, retract remaining flaps and climb straight ahead.
    narration: {fileID: 8300000, guid: 1cf749655b2f3ee4785998523288824e, type: 3}
    task: 23
    reference: 9
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 75
    dwellSeconds: 5
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 000000000200000004000000030000000100000007000000060000000a00000009000000
