%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 02_first_flight
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 02_first_flight
  displayName: Level flight and gentle turns
  briefing: Learn the cockpit references, then practice level flight and gentle turns.
    The instructor coaches you as you fly. Menu pauses; X repeats the current cue.
  briefingNarration: {fileID: 8300000, guid: cae490adc64efc046ac293119d10c0dd, type: 3}
  start:
    latitudeDegrees: 40.05467080422664
    longitudeDegrees: -105.21085768949152
    altitudeMslMeters: 2133.6
    terrainElevationMslMeters: 1583.2224005340577
    calibratedAirspeedKnots: 79.95769500732422
    headingDegrees: 90
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: 0
    engineRunning: 1
  initialThrottle: 0.72705275
  initialTrim: -0.21362303
  initialFlaps: 0
  allowDemonstration: 1
  airportExercise: 0
  goAroundStage: -1
  stages:
  - title: Wings level
    instruction: You have control. Keep the wings level against the outside horizon.
    narration: {fileID: 8300000, guid: c2086b0f7d412ee4abe977dd0e37f68b, type: 3}
    task: 6
    reference: 0
    attitudeOnly: 1
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 12
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Altitude cross-check
    instruction: Check the altimeter. Hold about seven thousand feet, then look outside
      again.
    narration: {fileID: 8300000, guid: 997e29733d964c1498a1da9a8da05163, type: 3}
    task: 6
    reference: 3
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 12
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Airspeed cross-check
    instruction: Check the airspeed needle. Aim for ninety knots with small power
      adjustments.
    narration: {fileID: 8300000, guid: d8013fd23dc1c7e49bdbae54e294ad72, type: 3}
    task: 6
    reference: 1
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 12
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Heading cross-check
    instruction: Read the heading at the top index. Hold zero nine zero, then look
      outside.
    narration: {fileID: 8300000, guid: f733037202c2a714cbb566fc6e78f173, type: 3}
    task: 6
    reference: 4
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 12
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Gentle left turn
    instruction: Turn gently left toward zero six zero. Use a shallow, coordinated
      bank.
    narration: {fileID: 8300000, guid: c53b01f2bc03ac94b87cef45d2f6a905, type: 3}
    task: 7
    reference: 4
    attitudeOnly: 0
    heading: 60
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Roll out
    instruction: Level the wings on zero six zero. Settle at seven thousand feet
      and ninety knots.
    narration: {fileID: 8300000, guid: 21b46e8316d0afe4c97fe6177dc8909b, type: 3}
    task: 6
    reference: 0
    attitudeOnly: 0
    heading: 60
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 10
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Gentle right turn
    instruction: Turn gently right toward zero nine zero. Keep the turn shallow and
      coordinated.
    narration: {fileID: 8300000, guid: 8976f7e26ada22f46afd51d381440231, type: 3}
    task: 7
    reference: 4
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Settle level
    instruction: Level the wings on zero nine zero. Hold altitude and speed with
      small corrections.
    narration: {fileID: 8300000, guid: 0d4d2b916eb7b634d9d4200d72ed2e45, type: 3}
    task: 6
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 10
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 000000000200000004000000030000000100000007000000060000000a00000009000000
