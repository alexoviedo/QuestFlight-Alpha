%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 01_taxi
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: 01_taxi
  displayName: Cockpit and taxi
  briefing: Start stopped on taxiway Alpha. Check the yoke, rudder and brakes, then
    taxi toward runway 08 and stop before entering it. The right thumbstick controls
    rudder; grasp the cockpit controls to operate them. A pauses, B repeats an instruction.
    This lesson does not include engine starting or runway entry.
  briefingNarration: {fileID: 8300000, guid: 342c401618466274cb0d3ea83a1fca64, type: 3}
  start:
    latitudeDegrees: 40.03854574952252
    longitudeDegrees: -105.2323566122907
    altitudeMslMeters: 1613.6363999723435
    terrainElevationMslMeters: 1612.3863999723435
    calibratedAirspeedKnots: 0
    headingDegrees: 270
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: 0
    engineRunning: 1
  initialThrottle: 0.1
  initialTrim: 0
  initialFlaps: 0
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: -1
  stages:
  - title: Check roll
    instruction: At idle, grasp the yoke. Move it left and right, then center it.
    narration: {fileID: 8300000, guid: 19dc7aeecf062364c830f70f1d0daf4f, type: 3}
    task: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Check pitch
    instruction: Move the yoke gently forward and back, then center it.
    narration: {fileID: 8300000, guid: fa84df69b3afd3f428673e2a026c2686, type: 3}
    task: 1
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Check rudder
    instruction: Move the right thumbstick left and right, then center it. It controls
      rudder and ground steering.
    narration: {fileID: 8300000, guid: 88d4278d6b7140347a552cdaac151313, type: 3}
    task: 2
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Check brakes
    instruction: Keep the throttle at idle. Press both toe brakes and hold the airplane
      stopped.
    narration: {fileID: 8300000, guid: bb7845a458be52c4c8653e6cda21c75b, type: 3}
    task: 3
    heading: 90
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 2
    timeoutSeconds: 180
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Taxi west
    instruction: Release the brakes. Add a little power and follow the taxiway west
      at walking speed, about 3 to 6 knots. Slow near the runway-end connector.
    narration: {fileID: 8300000, guid: 5fb3798724be13d4480d1c1d2c4027f2, type: 3}
    task: 4
    heading: 270
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: -600, y: -91}
    captureMeters: 20
  - title: Turn toward hold short
    instruction: At the connector, turn right toward the runway. Keep the taxi speed
      low and be ready to stop before the hold-short line.
    narration: {fileID: 8300000, guid: fde3e86ab2dd13c43b19d58f609eba48, type: 3}
    task: 4
    heading: 0
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 1
    timeoutSeconds: 180
    targetEnu: {x: -620, y: -80}
    captureMeters: 14
  - title: Stop before runway
    instruction: Close the throttle and apply both brakes. Stop before the hold-short
      line; do not enter the runway.
    narration: {fileID: 8300000, guid: 6cf1c573f2793964aaef7d10f539b169, type: 3}
    task: 5
    heading: 0
    altitudeFeet: 7000
    speedKnots: 90
    dwellSeconds: 3
    timeoutSeconds: 180
    targetEnu: {x: -620, y: -72}
    captureMeters: 15
