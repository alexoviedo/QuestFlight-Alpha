  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 03_glide_energy
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: sgs233.reference.glide_energy
  program: 1
  groundTowPreparation: 0
  soaringWeather: {fileID: 11400000, guid: 50d9fcea1d5790f46a7b4432eb0d5b13, type: 2}
  displayName: Glide and energy
  briefing: SGS 2-33A / PA-18 development reference, 950 lb dual glider loading.
    These are simulator modules, not a Mile High syllabus or training credit. Physical
    inspection and crew communication are explained, not scored as performed. Use
    pitch for speed and the yaw string for coordination. Move trim to reduce sustained
    stick force, observe descent with airbrakes, then make a modest slip. Optional
    demonstration/assistance is labeled and never gives independent credit. There
    is no engine or powered go-around.
  briefingNarration: {fileID: 0}
  learningGoal: Glide and energy using measured controls, native state and sustained
    conditions.
  reflection: Which outside cue and instrument supported your decision? What margin
    would you require before an instructor-reviewed real flight?
  start:
    latitudeDegrees: 40.05917788542087
    longitudeDegrees: -105.21202489828113
    altitudeMslMeters: 2461.7824
    terrainElevationMslMeters: 1584.9157351135254
    calibratedAirspeedKnots: 50
    headingDegrees: 90
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: -2.862400417
    engineRunning: 0
  initialThrottle: 0
  initialTrim: 0.10626088
  initialFlaps: 0
  allowDemonstration: 1
  airportExercise: 0
  goAroundStage: -1
  stages:
  - title: Glide speed
    instruction: Settle at50kt with wings nearly level and yaw string centered.
    narration: {fileID: 0}
    successFeedback: Glide speed was observed within the reference practice window.
    retryAdvice: Use pitch to control speed; there is no throttle.
    task: 104
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 8
    timeoutSeconds: 300
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Relieve stick force
    instruction: Adjust trim and settle the glide with little sustained stick input.
    narration: {fileID: 0}
    successFeedback: Relieve stick force was observed within the reference practice
      window.
    retryAdvice: Move trim, keep coordination and reduce held pitch input.
    task: 105
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 8
    timeoutSeconds: 300
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Increase descent
    instruction: "Extend airbrakes beyond halfway while preserving35\u201365kt and
      nearly level wings."
    narration: {fileID: 0}
    successFeedback: Increase descent was observed within the reference practice
      window.
    retryAdvice: Pitch maintains speed; the lever changes drag and descent.
    task: 106
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 6
    timeoutSeconds: 300
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Modest slip
    instruction: Close airbrakes. Hold a modest side-slip with bank below 20 degrees
      for 3 seconds, then recover to centered yaw string and wings nearly level for
      3 seconds.
    narration: {fileID: 0}
    successFeedback: Modest slip was observed within the reference practice window.
    retryAdvice: Keep speed in range; use restrained opposing controls. Spins are
      not validated.
    task: 107
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 3
    timeoutSeconds: 300
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 
