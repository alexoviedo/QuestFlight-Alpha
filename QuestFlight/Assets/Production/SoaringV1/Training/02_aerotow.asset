  m_Script: {fileID: 11500000, guid: 5caaecf10ae238445afcc22c19aa33c6, type: 3}
  m_Name: 02_aerotow
  m_EditorClassIdentifier: Assembly-CSharp::QuestFlight.Product.Training.TrainingLessonDefinition
  lessonId: sgs233.reference.aerotow
  program: 1
  groundTowPreparation: 1
  soaringWeather: {fileID: 11400000, guid: 92b614c4163e9f843a2d402f59af42ee, type: 2}
  displayName: Normal aerotow
  briefing: SGS 2-33A / PA-18 development reference, 950 lb dual glider loading.
    These are simulator modules, not a Mile High syllabus or training credit. Physical
    inspection and crew communication are explained, not scored as performed. Complete
    the ground checks and crew reconnection. Close the brakes, center the stick,
    then request shared-runway clearance in Menu > Launch preparation. Follow the
    tug near55kt. At the reference release cue, check separation and deliberately
    pull the red handle or A. The tug uses native controls to return.
  briefingNarration: {fileID: 0}
  learningGoal: Normal aerotow using measured controls, native state and sustained
    conditions.
  reflection: Which outside cue and instrument supported your decision? What margin
    would you require before an instructor-reviewed real flight?
  start:
    latitudeDegrees: 40.05917788542087
    longitudeDegrees: -105.21202489828113
    altitudeMslMeters: 2461.7824
    terrainElevationMslMeters: 1584.9157351135254
    calibratedAirspeedKnots: 50
    headingDegrees: 90
    pitchDegrees: 0
    bankDegrees: 0
    flightPathAngleDegrees: -2.862400417
    engineRunning: 0
  initialThrottle: 0
  initialTrim: 0.10626088
  initialFlaps: 0
  allowDemonstration: 0
  airportExercise: 1
  goAroundStage: -1
  stages:
  - title: Ground checks
    instruction: Complete control sweeps, combined brake check and release test.
    narration: {fileID: 0}
    successFeedback: Ground checks was observed within the reference practice window.
    retryAdvice: Remain stopped while checking the actual controls.
    task: 100
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 1
    timeoutSeconds: 300
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Clearance and launch
    instruction: Menu > Launch preparation > Reconnect and prepare launch (already prepared after Skip preflight). Return
      to cockpit; close brakes and center controls. Then Menu > Launch preparation
      > Clear and begin launch.
    narration: {fileID: 0}
    successFeedback: Clearance and launch was observed within the reference practice
      window.
    retryAdvice: Both strips must be clear. Close brakes and center controls before
      requesting clearance.
    task: 101
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 3
    timeoutSeconds: 500
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Tow position
    instruction: Follow the tug with small coordinated corrections near55kt. Keep
      a steady sight picture through the turn.
    narration: {fileID: 0}
    successFeedback: Tow position was observed within the reference practice window.
    retryAdvice: Reduce lateral/height error and oscillation; maintain coordination
      and modest rope load.
    task: 102
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 20
    timeoutSeconds: 700
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  - title: Deliberate release
    instruction: Wait for the reference release cue; check separation and pull red
      handle / A. Then stabilize the unpowered glide.
    narration: {fileID: 0}
    successFeedback: Deliberate release was observed within the reference practice
      window.
    retryAdvice: Release is pilot-controlled. Keep safe speed and separation from
      the tug.
    task: 103
    reference: 0
    attitudeOnly: 0
    heading: 90
    altitudeFeet: 7000
    speedKnots: 50
    dwellSeconds: 3
    timeoutSeconds: 900
    targetEnu: {x: 0, y: 0}
    captureMeters: 200
  orientation: 
